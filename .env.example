# Secret qui signe le cookie de session et le jeton du compagnon Backloggd (chaîne aléatoire longue).
APP_SECRET=
# Adresse publique de l'appli (facultatif : sinon déduite de la requête).
APP_URL=
# Fuseau horaire de l'appli (dates de fin « aujourd'hui », calendrier). Paris par défaut.
NEXT_PUBLIC_TIMEZONE=Europe/Paris

# Connexion Discord : https://discord.com/developers/applications → OAuth2.
# Redirects : <adresse de l'appli>/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Facultatif : identifiant Discord du propriétaire (sinon, le premier qui se connecte reprend le compte n°1),
# et liste d'identifiants acceptés d'office (séparés par des virgules ; les autres attendent la validation).
DISCORD_OWNER_ID=
DISCORD_ALLOWED_IDS=

# Base distante (obligatoire sur Vercel). Sans elle, la base est le fichier data/almanach.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# AniList : créer un client sur https://anilist.co/settings/developer
# avec comme Redirect URL <adresse de l'appli>/reglages/anilist
ANILIST_CLIENT_ID=

# Facultatif : recherche de films (https://www.themoviedb.org/settings/api, « API Read Access Token »).
TMDB_TOKEN=
# Facultatif : clé API Web Steam (sinon, à saisir dans Réglages).
STEAM_API_KEY=
# Facultatif : Google Books en plus d'Open Library pour les romans.
GOOGLE_BOOKS_KEY=
# Facultatif : IGDB (bannières et sociétés des jeux) via une appli Twitch (dev.twitch.tv/console/apps).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Facultatif : SteamGridDB (jaquettes et bannières de jeux) : steamgriddb.com/profile/preferences/api
STEAMGRIDDB_KEY=

# Compagnon Backloggd (npm run backloggd) : adresse de l'appli et jeton affiché dans Réglages.
ALMANACH_URL=http://localhost:3000
ALMANACH_TOKEN=
# Navigateur piloté : msedge (défaut) ou chrome.
BACKLOGGD_BROWSER=msedge
